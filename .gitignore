# Wallpapers & backgrounds (symlinks a ~/Pictures/ , binarios pesados)
.config/omarchy/backgrounds/
.config/omarchy/themes/**/backgrounds/
.config/omarchy/themes/**/wallpapers/

# Current theme (generado, cambia en cada omarchy theme set)
.config/omarchy/current/

# Caches de cualquier app
**/cache/
**/*.cache/
**/__pycache__/

# MPD runtime state (database/log/state se regeneran solos, no se versionan)
.config/mpd/database
.config/mpd/log
.config/mpd/state
.config/mpd/sticker.sql

# Logs
*.log

# OS
.DS_Store
Thumbs.db
# Local Pi runtime state
.atl/
